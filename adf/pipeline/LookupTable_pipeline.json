{
	"name": "LookupTable_pipeline",
	"properties": {
		"activities": [
			{
				"name": "Get_all_lookup_tables",
				"type": "Lookup",
				"dependsOn": [],
				"policy": {
					"timeout": "0.12:00:00",
					"retry": 0,
					"retryIntervalInSeconds": 30,
					"secureOutput": false,
					"secureInput": false
				},
				"userProperties": [],
				"typeProperties": {
					"source": {
						"type": "SqlServerSource",
						"sqlReaderQuery": "select top 20\ns.Name as SchemaName,\nt.name as TableName\nfrom sys.tables as t \ninner join sys.schemas as s \non t.schema_id = s.schema_id",
						"queryTimeout": "02:00:00",
						"isolationLevel": "ReadCommitted",
						"partitionOption": "None"
					},
					"dataset": {
						"referenceName": "SqlServerTable1",
						"type": "DatasetReference"
					},
					"firstRowOnly": false
				}
			},
			{
				"name": "ForEach_lookupTables",
				"type": "ForEach",
				"dependsOn": [
					{
						"activity": "Get_all_lookup_tables",
						"dependencyConditions": [
							"Skipped"
						]
					}
				],
				"userProperties": []
			}
		],
		"annotations": []
	}
}